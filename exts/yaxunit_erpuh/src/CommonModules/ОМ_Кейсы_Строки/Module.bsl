// Кейс-тесты метода СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке (кейсов: 7).
Процедура ТолькоЦифрыВСтроке(Знач ИмяКейса) Экспорт
	
	Кейс = ОМ_Кейсы.НайтиКейс(КейсыТолькоЦифрыВСтроке(), ИмяКейса);
	
	Результат = Неопределено;
	ИнформацияОбИсключении = Неопределено;
	Попытка
		Если Кейс.Аргументы.Количество() = 1 Тогда
			Результат = СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ОМ_Кейсы.Аргумент(Кейс, 0));
		ИначеЕсли Кейс.Аргументы.Количество() = 3 Тогда
			Результат = СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ОМ_Кейсы.Аргумент(Кейс, 0), ОМ_Кейсы.Аргумент(Кейс, 1), ОМ_Кейсы.Аргумент(Кейс, 2));
		Иначе
			ВызватьИсключение СтрШаблон("Кейс «%1»: число аргументов %2 не описано в генераторе", Кейс.Имя, ?(Кейс.Аргументы = Неопределено, 0, Кейс.Аргументы.Количество()));
		КонецЕсли;
	Исключение
		ИнформацияОбИсключении = ИнформацияОбОшибке();
	КонецПопытки;
	
	ОМ_Кейсы.ПроверитьКейс(Кейс, Результат, ИнформацияОбИсключении);
	
КонецПроцедуры

