	ОМ_Кейсы.Добавить(Кейсы, "скобки-минус", ЮТКоллекции.ЗначениеВМассиве("(10)"), -10);
	ОМ_Кейсы.Добавить(Кейсы, "минус", ЮТКоллекции.ЗначениеВМассиве("-10"), -10);
	ОМ_Кейсы.Добавить(Кейсы, "запятая", ЮТКоллекции.ЗначениеВМассиве("10,2"), 10.2);
	ОМ_Кейсы.Добавить(Кейсы, "точка", ЮТКоллекции.ЗначениеВМассиве("10.2"), 10.2);
