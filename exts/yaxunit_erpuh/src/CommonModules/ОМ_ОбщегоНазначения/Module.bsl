		.Свойство("КвалификаторыДаты.ЧастиДаты").Равно(ОжидаемыеЧастиДаты);
	
КонецПроцедуры

// ОписаниеТипаСостоитИзТипа возвращает Истина только для описания ровно из одного указанного типа.
Процедура ОписаниеТипаСостоитИзТипаВозвращаетИстинуТолькоДляЕдинственногоТипа() Экспорт
	
	// given
	ОписаниеСтроки = ОбщегоНазначения.ОписаниеТипаСтрока(10);
	ОписаниеНесколькихТипов = Новый ОписаниеТипов("Строка, Число");
	
	// then
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(ОписаниеСтроки, Тип("Строка")))
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(ОписаниеСтроки, Тип("Число")))
		.ЭтоЛожь();
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(ОписаниеНесколькихТипов, Тип("Строка")))
		.ЭтоЛожь();
	
КонецПроцедуры

// ЭтоСсылка распознает ссылочные типы и не считает ссылкой неопределено.
Процедура ЭтоСсылкаРаспознаетСсылочныйТип() Экспорт
	
	// then
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЭтоСсылка(Тип("СправочникСсылка.Валюты")))
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЭтоСсылка(Тип("Строка")))
		.ЭтоЛожь();
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЭтоСсылка(Тип("Неопределено")))
		.ЭтоЛожь();
	
КонецПроцедуры

// СтроковоеПредставлениеТипа возвращает имя простого типа.
//
// Параметры:
//  ПроверяемыйТип - Тип - тип, имя которого возвращает проверяемый метод.
//  ОжидаемоеИмя - Строка - ожидаемое имя простого типа.
Процедура СтроковоеПредставлениеТипаВозвращаетИмяПростогоТипа(ПроверяемыйТип, ОжидаемоеИмя) Экспорт
	
	// given - проверяемый тип передан параметром теста
	
	// when
	ИмяТипа = ОбщегоНазначения.СтроковоеПредставлениеТипа(ПроверяемыйТип);
	
	// then
	ЮТест.ОжидаетЧто(ИмяТипа).Равно(ОжидаемоеИмя);
	
КонецПроцедуры

// СтроковоеПредставлениеТипа возвращает полное имя типа ссылки.
