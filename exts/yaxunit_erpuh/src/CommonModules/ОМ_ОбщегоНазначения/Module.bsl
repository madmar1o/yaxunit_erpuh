// КонтрольнаяСуммаСтрокой возвращает устойчивый хеш данных заданным алгоритмом (по умолчанию MD5).
//
// Параметры:
//  КодАлгоритма - Строка - код алгоритма хеширования: «MD5», «SHA256»; пустая строка - алгоритм по умолчанию.
//  ОжидаемаяДлинаХеша - Число - ожидаемая длина хеша в символах.
Процедура КонтрольнаяСуммаСтрокойВозвращаетХешДанных(КодАлгоритма, ОжидаемаяДлинаХеша) Экспорт
	
	// given
	Данные = "YAxUnit: проверка контрольной суммы";
	// Значение перечисления ХешФункция создается в тесте: системные перечисления
	// не сериализуются при передаче параметров теста на сервер.
	Если КодАлгоритма = "MD5" Тогда
		Алгоритм = ХешФункция.MD5;
	ИначеЕсли КодАлгоритма = "SHA256" Тогда
		Алгоритм = ХешФункция.SHA256;
	Иначе
		Алгоритм = Неопределено; // алгоритм по умолчанию
	КонецЕсли;
	
	// when
	КонтрольнаяСумма = ОбщегоНазначения.КонтрольнаяСуммаСтрокой(Данные, Алгоритм);
	КонтрольнаяСуммаПовторно = ОбщегоНазначения.КонтрольнаяСуммаСтрокой(Данные, Алгоритм);
	
	// then
	ЮТест.ОжидаетЧто(КонтрольнаяСумма)
		.ИмеетТип("Строка")
		.ИмеетДлину(ОжидаемаяДлинаХеша)
		.Равно(КонтрольнаяСуммаПовторно);
	
КонецПроцедуры

