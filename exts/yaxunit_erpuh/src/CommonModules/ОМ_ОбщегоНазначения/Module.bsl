	// given
	Справочник = Метаданные.Справочники.Пользователи;
	Документ = Метаданные.Документы.АвансовыйОтчет;
	
	// then
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЭтоСправочник(Справочник)).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЭтоСправочник(Документ)).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЭтоДокумент(Документ)).ЭтоИстина();
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЭтоДокумент(Справочник)).ЭтоЛожь();
	
КонецПроцедуры

