#Область ОписанияТипов

// ОписаниеТипаСтрока формирует описание типа «Строка» с указанной длиной.
Процедура ОписаниеТипаСтрокаВозвращаетТипСтрокаЗаданнойДлины() Экспорт
	
	// given
	ДлинаСтроки = 50;
	
	// when
	ОписаниеТипа = ОбщегоНазначения.ОписаниеТипаСтрока(ДлинаСтроки);
	
	// then
	ЮТест.ОжидаетЧто(ОписаниеТипа)
		.ИмеетТип("ОписаниеТипов")
		.Свойство("КвалификаторыСтроки.Длина").Равно(ДлинаСтроки);
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(ОписаниеТипа, Тип("Строка")))
		.ЭтоИстина();
	
КонецПроцедуры

// ОписаниеТипаЧисло формирует описание типа «Число» с указанными квалификаторами.
// Если знак числа не передан, допустимым знаком считается любой.
//
// Параметры:
//  Разрядность - Число - общее количество разрядов числа.
//  РазрядностьДробнойЧасти - Число - количество разрядов дробной части.
//  КодЗнака - Число - код знака числа: 0 - любой, 1 - неотрицательный.
Процедура ОписаниеТипаЧислоЗадаетРазрядностьДробнуюЧастьИЗнак(Разрядность, РазрядностьДробнойЧасти, КодЗнака) Экспорт
	
	// given - разрядность и код знака числа переданы параметрами теста;
	// значение перечисления ДопустимыйЗнак создается в тесте: системные перечисления
	// не сериализуются при передаче параметров теста на сервер.
	Если КодЗнака = "Неотрицательный" Тогда
		ЗнакЧисла = ДопустимыйЗнак.Неотрицательный;
	Иначе
		ЗнакЧисла = Неопределено; // допустимый знак не указан
	КонецЕсли;
	ОжидаемыйЗнак = ?(ЗнакЧисла = Неопределено, ДопустимыйЗнак.Любой, ЗнакЧисла);
	
	// when
	ОписаниеТипа = ОбщегоНазначения.ОписаниеТипаЧисло(Разрядность, РазрядностьДробнойЧасти, ЗнакЧисла);
	
	// then
	ЮТест.ОжидаетЧто(ОписаниеТипа)
		.ИмеетТип("ОписаниеТипов")
		.Свойство("КвалификаторыЧисла.Разрядность").Равно(Разрядность)
		.Свойство("КвалификаторыЧисла.РазрядностьДробнойЧасти").Равно(РазрядностьДробнойЧасти)
		.Свойство("КвалификаторыЧисла.ДопустимыйЗнак").Равно(ОжидаемыйЗнак);
	
КонецПроцедуры

// ОписаниеТипаДата формирует описание типа «Дата» с указанными частями даты.
Процедура ОписаниеТипаДатаЗадаетЧастиДаты() Экспорт
	
	// given
