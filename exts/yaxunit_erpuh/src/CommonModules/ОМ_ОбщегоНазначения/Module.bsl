	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Код");
	Результат.Колонки.Добавить("Наименование");
	
	Возврат Результат;
	
КонецФункции

// Таблица значений с двумя строками для проверки преобразований.
Функция ТаблицаСДвумяСтроками()
	
	Результат = НоваяТаблицаСДвумяКолонками();
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.Код = "001";
	СтрокаТаблицы.Наименование = "Первый";
	
	СтрокаТаблицы = Результат.Добавить();
	СтрокаТаблицы.Код = "002";
	СтрокаТаблицы.Наименование = "Второй";
	
	Возврат Результат;
	
КонецФункции

// Таблица значений с повторяющимися кодами для проверки выгрузки колонки.
Функция ТаблицаСПовторяющимисяКодами()
	
	Результат = НоваяТаблицаСДвумяКолонками();
	
	Для Каждого Код Из ЮТКоллекции.ЗначениеВМассиве("001", "001", "002") Цикл
		СтрокаТаблицы = Результат.Добавить();
		СтрокаТаблицы.Код = Код;
		СтрокаТаблицы.Наименование = "Строка " + Код;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

