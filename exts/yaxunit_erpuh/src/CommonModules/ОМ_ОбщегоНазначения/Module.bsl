// Проверяет вывод сообщения пользователю методом БСП общего назначения
// ОбщегоНазначения.СообщитьПользователю.
//
// Метод БСП: ОбщегоНазначения.СообщитьПользователю(ТекстСообщенияПользователю, КлючДанных, Поле, ПутьКДанным, Отказ).
// Очередь сообщений читается методом глобального контекста ПолучитьСообщенияПользователю().
Процедура СообщитьПользователюВыводитСообщениеВОчередь() Экспорт
	
	// Уникальный текст, чтобы проверка не зависела от прочих сообщений в очереди.
	ТекстСообщения = СтрШаблон("YAxUnit: проверка вывода сообщения пользователю %1", Строка(Новый УникальныйИдентификатор));
	
	// Очередь сообщений очищаем, чтобы проверять только результат тестируемого метода.
	ПолучитьСообщенияПользователю(Истина);
	
	// Тестируемый метод БСП общего назначения.
	Отказ = Ложь;
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	
	Сообщения = ПолучитьСообщенияПользователю();
	
	ЮТест.ОжидаетЧто(Сообщения.Количество(), "БСП вывела ровно одно сообщение пользователю")
		.Равно(1);
	
	ЮТест.ОжидаетЧто(Сообщения[0].Текст, "Текст выведенного сообщения не искажен")
		.Равно(ТекстСообщения);
	
	ЮТест.ОжидаетЧто(Отказ, "БСП установила признак отказа в значение Истина")
		.Равно(Истина);
	
КонецПроцедуры

