// ОМ_Кейсы — исполнитель data-driven кейсов (JSON → сгенерированные тесты).
//
// Тестовые модули вида ОМ_Кейсы_* проверок не содержат: они находят кейс данных,
// вызывают тестируемый метод и передают сюда результат. Все ожидания (значение или
// исключение) описаны данными, а проверки выполняет этот модуль через публичный API ЮТест.
// Благодаря этому инверсия ожиданий в JSON делает падающими все кейсы (проверка честности).
//
// См. также: cases\README.md, tools\gen-test-cases.ps1.

#Область ПрограммныйИнтерфейс

// Добавляет кейс в массив кейсов тестового модуля.
//
// Параметры:
//  Кейсы - Массив из Структура - формируемый список кейсов.
//  ИмяКейса - Строка - идентификатор кейса; уникален в методе, попадает в имя теста.
//  Аргументы - Массив из Произвольный, Неопределено - позиционные аргументы вызова метода.
//  Ожидание - Произвольный - ожидаемое значение результата (когда исключение не ожидается).
//  ОжидаемоеИсключение - Строка, Неопределено - подстрока текста ожидаемого исключения.
Процедура Добавить(Знач Кейсы, Знач ИмяКейса, Знач Аргументы, Знач Ожидание, Знач ОжидаемоеИсключение = Неопределено) Экспорт
	
	Кейс = Новый Структура("Имя, Аргументы, Ожидание, ОжидаемоеИсключение", ИмяКейса, Аргументы, Ожидание, ОжидаемоеИсключение);
	Кейсы.Добавить(Кейс);
	
КонецПроцедуры

// Находит кейс по идентификатору. Исключение — защита от расхождения данных и регистрации тестов.
//
// Параметры:
//  Кейсы - Массив из Структура - список кейсов.
//  ИмяКейса - Строка - идентификатор кейса.
//
// Возвращаемое значение:
//  Структура - найденный кейс.
Функция НайтиКейс(Знач Кейсы, Знач ИмяКейса) Экспорт
	
	Для Каждого Кейс Из Кейсы Цикл
		Если Кейс.Имя = ИмяКейса Тогда
			Возврат Кейс;
		КонецЕсли;
	КонецЦикла;
	
	ВызватьИсключение СтрШаблон("Кейс не найден: %1", ИмяКейса);
	
КонецФункции

// Возвращает позиционный аргумент кейса.
//
// Параметры:
//  Кейс - Структура - кейс, см. Добавить.
//  Номер - Число - индекс аргумента (с нуля).
//
// Возвращаемое значение:
//  Произвольный - значение аргумента.
Функция Аргумент(Знач Кейс, Знач Номер) Экспорт
	
	Возврат Кейс.Аргументы[Номер];
	
КонецФункции

// Проверяет результат вызова метода по ожиданиям кейса; провал — через гарантированный отказ ЮТест.
//
// Параметры:
//  Кейс - Структура - кейс, см. Добавить.
//  Результат - Произвольный - значение, которое вернул метод.
//  ИнформацияОбИсключении - ИнформацияОбОшибке, Неопределено - пойманное исключение или Неопределено.
Процедура ПроверитьКейс(Знач Кейс, Знач Результат, Знач ИнформацияОбИсключении) Экспорт
	
	Описание = СтрШаблон("кейс «%1»", Кейс.Имя);
	
	Если ЗначениеЗаполнено(Кейс.ОжидаемоеИсключение) Тогда
		Если ИнформацияОбИсключении = Неопределено Тогда
			ЮТест.ОжидаетЧто(Ложь, СтрШаблон("%1: ожидалось исключение с текстом «%2», но исключения не было", Описание, Кейс.ОжидаемоеИсключение)).ЭтоИстина();
		Иначе
			ЮТест.ОжидаетЧто(ИнформацияОбИсключении.Описание, СтрШаблон("%1: текст исключения", Описание)).Содержит(Кейс.ОжидаемоеИсключение);
		КонецЕсли;
	Иначе
		Если ИнформацияОбИсключении <> Неопределено Тогда
			ЮТест.ОжидаетЧто(Ложь, СтрШаблон("%1: исключение не ожидалось, получено: %2", Описание, ИнформацияОбИсключении.Описание)).ЭтоИстина();
		Иначе
			ЮТест.ОжидаетЧто(Результат, Описание).Равно(Кейс.Ожидание);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
