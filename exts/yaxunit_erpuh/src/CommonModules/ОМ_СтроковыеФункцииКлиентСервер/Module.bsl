			.ДобавитьСерверныйТест("ИзвлечьТекстИзHTMLУбираетТеги", "ИзвлечьТекстИзHTML")
			.ДобавитьСерверныйТест("ИзвлечьТекстИзHTMLУбираетСкриптыИСтили", "ИзвлечьТекстИзHTML: скрипты и стили")
