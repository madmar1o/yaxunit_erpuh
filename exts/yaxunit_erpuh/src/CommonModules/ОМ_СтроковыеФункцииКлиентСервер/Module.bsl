#Область ПрограммныйИнтерфейс

// Регистрация тестов программного интерфейса общего модуля СтроковыеФункцииКлиентСервер (БСП).
// Тесты проверяют контракт экспортных методов: чистые преобразования строк без обращения
// к базе, без внешних ресурсов и без записи данных (юнит-уровень).
// См. https://bia-technologies.github.io/yaxunit/docs/features/test-registration
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.Настроить(ЮТАлюр
			.Epic("Модульное тестирование ERP.UH")
			.Функциональность("БСП. Строковые функции")
			.РодительскийНабор("ОМ_СтроковыеФункцииКлиентСервер")
			.Пакет("YAxUnit.ОМ_СтроковыеФункцииКлиентСервер")
			.Владелец("Разработка"))
		.ДобавитьТестовыйНабор("ОМ_СтроковыеФункцииКлиентСервер: разбор строк", "Юнит,БСП,Строки")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивПодстрокВозвращаетПустыеПодстроки", "РазложитьСтрокуВМассивПодстрок")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивПодстрокПропускаетПустыеПодстроки", "РазложитьСтрокуВМассивПодстрок: пропуск пустых")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивПодстрокПробелПропускаетПустыеПодстроки", "РазложитьСтрокуВМассивПодстрок: разделитель-пробел")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивПодстрокПустаяСтрока", "РазложитьСтрокуВМассивПодстрок: пустая строка")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивПодстрокОтключаетПропускПустыхСтрок", "РазложитьСтрокуВМассивПодстрок: явное отключение пропуска")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивПодстрокСокращаетНепечатаемыеСимволы", "РазложитьСтрокуВМассивПодстрок: сокращение непечатаемых")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивСловРазделяетПоРазделителямПоУмолчанию", "РазложитьСтрокуВМассивСлов")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивСловУчитываетЗаданныеРазделители", "РазложитьСтрокуВМассивСлов: заданные разделители")
			.ДобавитьСерверныйТест("РазложитьСтрокуВМассивСловПустаяСтрокаДаетПустойМассив", "РазложитьСтрокуВМассивСлов: пустая строка")
			.ДобавитьСерверныйТест("ЭтоРазделительСловРаспознаетРазделителиПоУмолчанию", "ЭтоРазделительСлов")
			.ДобавитьСерверныйТест("ЭтоРазделительСловУчитываетЗаданныйСписокРазделителей", "ЭтоРазделительСлов: заданный список")
		.ДобавитьТестовыйНабор("ОМ_СтроковыеФункцииКлиентСервер: подстановка параметров", "Юнит,БСП,Строки")
			.ДобавитьСерверныйТест("ПодставитьПараметрыВСтрокуПодставляетЗначенияПоНомерам", "ПодставитьПараметрыВСтроку")
			.ДобавитьСерверныйТест("ПодставитьПараметрыВСтрокуНеТеряетЗнакиПроцентаВЗначениях", "ПодставитьПараметрыВСтроку: процент в значении")
			.ДобавитьСерверныйТест("ПодставитьПараметрыВСтрокуИзМассиваПодставляетЗначенияПоНомерам", "ПодставитьПараметрыВСтрокуИзМассива")
			.ДобавитьСерверныйТест("ПодставитьПараметрыВСтрокуИзМассиваНеЗаменяетПустыеЗначения", "ПодставитьПараметрыВСтрокуИзМассива: пустое значение")
			.ДобавитьСерверныйТест("ВставитьПараметрыВСтрокуЗаменяетИменованныеПараметры", "ВставитьПараметрыВСтроку")
			.ДобавитьСерверныйТест("ПараметрыИзСтрокиРазбираетПараметрыИСнимаетКавычки", "ПараметрыИзСтроки")
			.ДобавитьСерверныйТест("ПараметрыИзСтрокиПропускаетФрагментыБезЗнакаРавенства", "ПараметрыИзСтроки: фрагмент без равенства")
		.ДобавитьТестовыйНабор("ОМ_СтроковыеФункцииКлиентСервер: проверки символов", "Юнит,БСП,Строки")
			.ДобавитьСерверныйТест("ТолькоЦифрыВСтрокеРаспознаетСтрокуИзЦифр", "ТолькоЦифрыВСтроке")
			.ДобавитьСерверныйТест("ТолькоЛатиницаВСтрокеРаспознаетЛатиницу", "ТолькоЛатиницаВСтроке")
			.ДобавитьСерверныйТест("ТолькоСимволыНациональногоАлфавитаВСтрокеРазрешаетКириллицу", "ТолькоСимволыНациональногоАлфавитаВСтроке")
			.ДобавитьСерверныйТест("ТолькоКириллицаВСтрокеРаспознаетКириллицу", "ТолькоКириллицаВСтроке")
			.ДобавитьСерверныйТест("ЭтоУникальныйИдентификаторРаспознаетФорматИдентификатора", "ЭтоУникальныйИдентификатор")
			.ДобавитьСерверныйТест("СократитьДвойныеКавычкиУдаляетКавычкиПоКраям", "СократитьДвойныеКавычки")
		.ДобавитьТестовыйНабор("ОМ_СтроковыеФункцииКлиентСервер: преобразования строк", "Юнит,БСП,Строки")
			.ДобавитьСерверныйТест("УдалитьПоследнийСимволВСтрокеОтрезаетСимволыСправа", "УдалитьПоследнийСимволВСтроке")
			.ДобавитьСерверныйТест("СформироватьСтрокуСимволовСтроитСтрокуИзПовторяющихсяСимволов", "СформироватьСтрокуСимволов")
			.ДобавитьСерверныйТест("ДополнитьСтрокуДополняетДоЗаданнойДлины", "ДополнитьСтроку")
			.ДобавитьСерверныйТест("УдалитьПовторяющиесяСимволыУдаляетКрайниеСимволы", "УдалитьПовторяющиесяСимволы")
			.ДобавитьСерверныйТест("ЗаменитьОдниСимволыДругимиМеняетСимволыПоПозиции", "ЗаменитьОдниСимволыДругими")
			.ДобавитьСерверныйТест("СтрокаВЧислоПреобразуетЧисловыеСтрокиБезИсключений", "СтрокаВЧисло")
			.ДобавитьСерверныйТест("СтрокаВЧислоВозвращаетНеопределеноДляНечисловойСтроки", "СтрокаВЧисло: нечисловая строка")
		.ДобавитьТестовыйНабор("ОМ_СтроковыеФункцииКлиентСервер: римские числа и склонения", "Юнит,БСП,Строки")
			.ДобавитьСерверныйТест("ПреобразоватьЧислоВРимскуюНотациюПреобразуетЧислоЛатиницей", "ПреобразоватьЧислоВРимскуюНотацию")
			.ДобавитьСерверныйТест("ПреобразоватьЧислоВРимскуюНотациюПоУмолчаниюВозвращаетКириллическуюНотацию", "ПреобразоватьЧислоВРимскуюНотацию: кириллица по умолчанию")
			.ДобавитьСерверныйТест("ПреобразоватьЧислоВАрабскуюНотациюПреобразуетРимскоеЧислоЛатиницей", "ПреобразоватьЧислоВАрабскуюНотацию")
			.ДобавитьСерверныйТест("ПреобразоватьЧислоВАрабскуюНотациюПоУмолчаниюОжидаетКириллическуюНотацию", "ПреобразоватьЧислоВАрабскуюНотацию: кириллица по умолчанию")
			.ДобавитьСерверныйТест("ФормаМножественногоЧислаВыбираетСклонениеПоЧислу", "ФормаМножественногоЧисла")
			.ДобавитьСерверныйТест("ЧислоЦифрамиПредметИсчисленияПрописьюДобавляетЧислоКРезультату", "ЧислоЦифрамиПредметИсчисленияПрописью")
