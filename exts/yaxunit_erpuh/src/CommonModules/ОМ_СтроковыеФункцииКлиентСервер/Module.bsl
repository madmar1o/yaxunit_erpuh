			.ДобавитьСерверныйТест("СтрокаВДатуВозвращаетПустуюДатуДляНеопознаннойСтроки", "СтрокаВДату: неопознанная строка")
			.ДобавитьСерверныйТест("СтрокаСЧисломДляЛюбогоЯзыкаСПустымШаблономВозвращаетФормат", "СтрокаСЧисломДляЛюбогоЯзыка: пустой шаблон")
			.ДобавитьСерверныйТест("СтрокаСЧисломДляЛюбогоЯзыкаФормируетПредставлениеПоШаблону", "СтрокаСЧисломДляЛюбогоЯзыка");
	
КонецПроцедуры

#Область РазборСтрок

// РазложитьСтрокуВМассивПодстрок по умолчанию сохраняет пустые подстроки для разделителя, отличного от пробела.
Процедура РазложитьСтрокуВМассивПодстрокВозвращаетПустыеПодстроки() Экспорт
	
	// given
	ОжидаемыеПодстроки = ЮТКоллекции.ЗначениеВМассиве("", "один", "", "два", "");
	
	// when
	Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(",один,,два,", ",");
	
	// then
	ЮТест.ОжидаетЧто(Подстроки)
		.ИмеетТип("Массив")
		.ИмеетДлину(5)
		.Равно(ОжидаемыеПодстроки);
	
КонецПроцедуры

// РазложитьСтрокуВМассивПодстрок с флагом ПропускатьПустыеСтроки не возвращает пустые подстроки.
Процедура РазложитьСтрокуВМассивПодстрокПропускаетПустыеПодстроки() Экспорт
	
	// given
	ОжидаемыеПодстроки = ЮТКоллекции.ЗначениеВМассиве("один", "два");
	
	// when
	Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(",один,,два,", ",", Истина);
	
	// then
	ЮТест.ОжидаетЧто(Подстроки)
		.ИмеетДлину(2)
		.Равно(ОжидаемыеПодстроки);
	
КонецПроцедуры

// Для разделителя-пробела пустые подстроки не попадают в результат и при незаданном флаге.
Процедура РазложитьСтрокуВМассивПодстрокПробелПропускаетПустыеПодстроки() Экспорт
	
	// given
	ОжидаемыеПодстроки = ЮТКоллекции.ЗначениеВМассиве("один", "два");
	
	// when
	Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(" один   два  ", " ");
	
	// then
	ЮТест.ОжидаетЧто(Подстроки)
		.ИмеетДлину(2)
		.Равно(ОжидаемыеПодстроки);
	
КонецПроцедуры

// Для пустой строки и разделителя, отличного от пробела, результат - пустой массив.
Процедура РазложитьСтрокуВМассивПодстрокПустаяСтрока() Экспорт
	
	// when
	Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("");
	
	// then
	ЮТест.ОжидаетЧто(Подстроки)
		.ИмеетТип("Массив")
		.ИмеетДлину(0);
	
КонецПроцедуры

// При явном отказе от пропуска пустых строк пустая строка дает массив с одной пустой подстрокой.
Процедура РазложитьСтрокуВМассивПодстрокОтключаетПропускПустыхСтрок() Экспорт
	
	// when
	Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("", , Ложь);
	
	// then
	ЮТест.ОжидаетЧто(Подстроки)
		.ИмеетДлину(1)
		.Равно(ЮТКоллекции.ЗначениеВМассиве(""));
	
КонецПроцедуры

// Параметр СокращатьНепечатаемыеСимволы обрезает пробелы по краям каждой подстроки.
Процедура РазложитьСтрокуВМассивПодстрокСокращаетНепечатаемыеСимволы() Экспорт
	
	// given
	ОжидаемыеПодстроки = ЮТКоллекции.ЗначениеВМассиве("один", "два");
	
	// when
	Подстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(" один , два ", ",", Истина, Истина);
	
	// then
	ЮТест.ОжидаетЧто(Подстроки)
		.ИмеетДлину(2)
		.Равно(ОжидаемыеПодстроки);
	
КонецПроцедуры

// РазложитьСтрокуВМассивСлов без явных разделителей делит строку по символам, не входящим в слова.
Процедура РазложитьСтрокуВМассивСловРазделяетПоРазделителямПоУмолчанию() Экспорт
	
	// given
	ОжидаемыеСлова = ЮТКоллекции.ЗначениеВМассиве("один", "два2_", "три");
	
	// when
	Слова = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов("один-@#два2_!три");
	
	// then
	ЮТест.ОжидаетЧто(Слова)
		.ИмеетТип("Массив")
		.Равно(ОжидаемыеСлова);
	
КонецПроцедуры

// РазложитьСтрокуВМассивСлов с заданным набором разделителей игнорирует прочие спецсимволы.
Процедура РазложитьСтрокуВМассивСловУчитываетЗаданныеРазделители() Экспорт
	
	// given
	ОжидаемыеСлова = ЮТКоллекции.ЗначениеВМассиве("один-", "два2", "три");
	
	// when
	Слова = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов("один-@#два2_!три", "#@!_");
	
	// then
	ЮТест.ОжидаетЧто(Слова)
		.ИмеетДлину(3)
		.Равно(ОжидаемыеСлова);
	
КонецПроцедуры

// РазложитьСтрокуВМассивСлов пустой строки возвращает пустой массив.
Процедура РазложитьСтрокуВМассивСловПустаяСтрокаДаетПустойМассив() Экспорт
	
	// when
	Слова = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов("");
	
	// then
	ЮТест.ОжидаетЧто(Слова)
		.ИмеетТип("Массив")
		.ИмеетДлину(0);
	
КонецПроцедуры

// ЭтоРазделительСлов без явного списка считает разделителями все, кроме букв, цифр и подчеркивания.
Процедура ЭтоРазделительСловРаспознаетРазделителиПоУмолчанию() Экспорт
	
	// given
	КодПробела = 32;
	КодТочки = 46;
	КодПодчеркивания = 95;
	КодЦифрыПять = 53;
	КодЛатинскойА = 65;
	КодКириллическойА = 1072;
	
	// then
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодПробела)).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодТочки)).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодПодчеркивания)).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодЦифрыПять)).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодЛатинскойА)).ЭтоЛожь();
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодКириллическойА)).ЭтоЛожь();
	
КонецПроцедуры

// ЭтоРазделительСлов с явным списком разделителей проверяет только символы этого списка.
Процедура ЭтоРазделительСловУчитываетЗаданныйСписокРазделителей() Экспорт
	
	// given
	Разделители = "._";
	КодТочки = 46;
	КодЛатинскойА = 65;
	
	// then
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодТочки, Разделители)).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтроковыеФункцииКлиентСервер.ЭтоРазделительСлов(КодЛатинскойА, Разделители)).ЭтоЛожь();
	
КонецПроцедуры

#КонецОбласти

#Область ПодстановкаПараметров

// ПодставитьПараметрыВСтроку подставляет значения по номерам вида %1..%9.
Процедура ПодставитьПараметрыВСтрокуПодставляетЗначенияПоНомерам() Экспорт
	
	// when
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 пошел в %2", "Вася", "Зоопарк");
	
	// then
	ЮТест.ОжидаетЧто(Результат).Равно("Вася пошел в Зоопарк");
	
КонецПроцедуры

// Знак процента внутри подставляемого значения не ломает подстановку прочих параметров.
Процедура ПодставитьПараметрыВСтрокуНеТеряетЗнакиПроцентаВЗначениях() Экспорт
	
	// when
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Скидка %1", "50%");
	
	// then
	ЮТест.ОжидаетЧто(Результат).Равно("Скидка 50%");
	
КонецПроцедуры

// ПодставитьПараметрыВСтрокуИзМассива подставляет значения массива по их номерам.
Процедура ПодставитьПараметрыВСтрокуИзМассиваПодставляетЗначенияПоНомерам() Экспорт
	
	// given
	ЗначенияПараметров = ЮТКоллекции.ЗначениеВМассиве("Вася", "Зоопарк");
	
	// when
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтрокуИзМассива("%1 пошел в %2", ЗначенияПараметров);
	
	// then
	ЮТест.ОжидаетЧто(Результат).Равно("Вася пошел в Зоопарк");
	
КонецПроцедуры

// Пустое значение параметра не подставляется, место вставки остается в строке.
Процедура ПодставитьПараметрыВСтрокуИзМассиваНеЗаменяетПустыеЗначения() Экспорт
	
	// given
